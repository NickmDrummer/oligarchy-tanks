pkgname=oligarchy-tanks
pkgver=0.1.0
pkgrel=1
pkgdesc='Retro 2-player local tank battle vs AI'
arch=('x86_64' 'aarch64')
license=('MIT' 'OFL')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
install=oligarchy-tanks.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/oligarchy-tanks "$pkgdir/usr/bin/oligarchy-tanks"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The bundled pixel fonts are redistributed with them, so their licences travel too.
  install -Dm644 src/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Silkscreen.txt"
  install -Dm644 src/fonts/OFL-DepartureMono.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-DepartureMono.txt"
  install -Dm644 src/fonts/OmarchyFont-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/OmarchyFont-MIT.txt"
  install -Dm644 "$startdir/oligarchy-tanks.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tanks.svg"
  install -Dm644 "$startdir/oligarchy-tanks.desktop" "$pkgdir/usr/share/applications/oligarchy-tanks.desktop"
}
