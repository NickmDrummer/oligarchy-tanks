<RCC>
    <qresource prefix="/">
        <file alias="Main.qml">Main.qml</file>
        <file alias="TankSprite.qml">TankSprite.qml</file>
        <file alias="ExplosionSprite.qml">ExplosionSprite.qml</file>
        <file alias="FrostSprite.qml">FrostSprite.qml</file>
        <file alias="ShieldSprite.qml">ShieldSprite.qml</file>
        <file alias="PixelButton.qml">PixelButton.qml</file>
        <file alias="PickupIcon.qml">PickupIcon.qml</file>
        <file alias="KeyCap.qml">KeyCap.qml</file>
        <file alias="PadIcon.qml">PadIcon.qml</file>
        <!-- The game's pixel font, Silkscreen (SIL OFL, see fonts/OFL.txt).
             Bundled so the UI looks the same on any machine. -->
        <file alias="fonts/Silkscreen-Regular.ttf">fonts/Silkscreen-Regular.ttf</file>
        <file alias="fonts/Silkscreen-Bold.ttf">fonts/Silkscreen-Bold.ttf</file>
        <file alias="fonts/DepartureMono-Regular.otf">fonts/DepartureMono-Regular.otf</file>
        <!-- The CRT shaders live here as .qsb files, precompiled from
             shaders/crt.vert and shaders/crt.frag with the qsb tool
             (Qt 6 does not accept inline GLSL in ShaderEffect).
             Regenerate with: qsb -qt6 -o shaders/crt.vert.qsb shaders/crt.vert
             and: qsb -qt6 -o shaders/crt.frag.qsb shaders/crt.frag -->
        <file alias="shaders/crt.vert.qsb">shaders/crt.vert.qsb</file>
        <file alias="shaders/crt.frag.qsb">shaders/crt.frag.qsb</file>
        <file alias="sounds/shoot.wav">sounds/shoot.wav</file>
        <file alias="sounds/hit.wav">sounds/hit.wav</file>
        <file alias="sounds/explode.wav">sounds/explode.wav</file>
        <file alias="sounds/power.wav">sounds/power.wav</file>
        <file alias="sounds/engine.wav">sounds/engine.wav</file>
        <file alias="sounds/engine_move.wav">sounds/engine_move.wav</file>
        <file alias="sounds/nuke.wav">sounds/nuke.wav</file>
        <file alias="sounds/blast_missile-shoot.wav">sounds/blast_missile-shoot.wav</file>
        <file alias="sounds/blast_missile-hit.wav">sounds/blast_missile-hit.wav</file>
        <file alias="sounds/air-support.wav">sounds/air-support.wav</file>
    </qresource>
</RCC>
