#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD="$ROOT/build"

# Parallel build jobs, without assuming GNU coreutils: macOS has no nproc,
# and this script is the one the README tells every platform to run.
if command -v nproc >/dev/null 2>&1; then
  JOBS="$(nproc)"
elif command -v sysctl >/dev/null 2>&1; then
  JOBS="$(sysctl -n hw.ncpu 2>/dev/null || echo 1)"
else
  JOBS=1
fi

# Qt 6 installs both names; Homebrew keeps qmake on a keg-only PATH, and some
# packages ship only qmake6.
if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "Neither qmake6 nor qmake is on the PATH." >&2
  exit 1
fi

mkdir -p "$BUILD"
cd "$BUILD"

# Extra arguments go to qmake, so a packaging build can ask for the release
# stamp: bin/build DEFINES+=OLIGARCHY_TANKS_RELEASE
#
# make only recompiles a source when the file itself changed, so a change in
# the compiler flags (a different DEFINES) would leave the old objects in
# place and the binary would keep the old behaviour. The arguments are
# therefore stamped, and a change of them wipes the build first.
STAMP="$BUILD/.qmake-args"
ARGS="$*"
PREVIOUS=""
[ -f "$STAMP" ] && PREVIOUS="$(cat "$STAMP")"

if [ "$PREVIOUS" != "$ARGS" ]; then
  if [ -f "$STAMP" ] || [ -n "$(ls -A "$BUILD" 2>/dev/null)" ]; then
    echo "Build flags changed, rebuilding from clean..." >&2
    rm -rf "$BUILD"
    mkdir -p "$BUILD"
    cd "$BUILD"
  fi
  printf '%s' "$ARGS" > "$STAMP"
fi

"$QMAKE" "$ROOT/oligarchy-tanks.pro" "$@"
make -j"$JOBS"

# make can miss a change and leave a stale binary behind. If any input is
# still newer than the binary, wipe and rebuild once from clean.
if [ -n "$(find "$ROOT/src" "$ROOT/oligarchy-tanks.pro" -newer "$ROOT/build/oligarchy-tanks" 2>/dev/null)" ]; then
  echo "Stale build detected, rebuilding from clean..." >&2
  rm -rf "$BUILD"
  mkdir -p "$BUILD"
  cd "$BUILD"
  printf '%s' "$ARGS" > "$STAMP"
  "$QMAKE" "$ROOT/oligarchy-tanks.pro" "$@"
  make -j"$JOBS"
fi

echo "Built $ROOT/build/oligarchy-tanks"
